# Konfiguracja stacku. Bez sekretow — aplikacja ich nie potrzebuje.
COMPOSE_PROJECT_NAME=brewcode-favicon
APP_PORT=3240
NODE_ENV=development

# Google Analytics 4 — identyfikator strumienia danych, np. G-ABC123XYZ.
# Puste = GA wylaczone (skrypt sie nie laduje). Czytany w runtime: po zmianie
# wystarczy `docker compose up -d` (odtworzenie kontenera), bez przebudowy.
GA_MEASUREMENT_ID="G-7FGQLFKDE9"

# Tylko produkcja (docker-compose.prod.yml):
APP_DOMAIN=favicon.brwcd.dev
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=letsencrypt
# TRAEFIK_NETWORK=web
